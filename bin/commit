#!/usr/bin/env bash

set -u


DEDICATORY_FILE="$HOME/dedicatory.txt"
PENDING_MERGES_FILE="commit_pending_merges.txt"

#
# Repositories matching this URL are considered ca2-owned and may be
# recursively committed/pushed.
#
OWNED_REMOTE_REGEX='github\.com[:/]ca2/'


pushd()
{
    command pushd "$@" > /dev/null
}


popd()
{
    command popd "$@" > /dev/null
}


is_owned_remote()
{
    local url="$1"

    [[ "$url" =~ $OWNED_REMOTE_REGEX ]]
}


get_push_branch()
{
    local configured_branch="${1:-}"
    local branch


    #
    # Explicit branch configured in .gitmodules.
    #

    if [ -n "$configured_branch" ] &&
       [ "$configured_branch" != "." ]; then

        printf '%s\n' "$configured_branch"
        return 0

    fi


    #
    # Current branch, when not detached.
    #

    branch=$(git symbolic-ref \
        --quiet \
        --short HEAD \
        2>/dev/null || true)

    if [ -n "$branch" ]; then

        printf '%s\n' "$branch"
        return 0

    fi


    #
    # Detached HEAD is normal for submodules.
    #
    # Try origin/HEAD.
    #

    branch=$(git symbolic-ref \
        --quiet \
        --short refs/remotes/origin/HEAD \
        2>/dev/null || true)

    if [ -n "$branch" ]; then

        branch="${branch#origin/}"

        printf '%s\n' "$branch"
        return 0

    fi


    #
    # ca2 default.
    #

    printf '%s\n' "main"
}


append_pending_merge()
{
    local relative_path="$1"

    if [ -z "$relative_path" ]; then
        return
    fi

    #
    # Avoid duplicate entries.
    #

    if ! grep -Fqx -- "$relative_path" "$ROOT_PENDING_FILE" \
        2>/dev/null; then

        printf '%s\n' "$relative_path" >> "$ROOT_PENDING_FILE"

    fi
}


repository_requires_merge()
{
    local configured_branch="${1:-}"
    local branch
    local remote_ref


    branch=$(get_push_branch "$configured_branch")

    remote_ref="refs/remotes/origin/$branch"


    #
    # Refresh origin so the test is against the current remote state.
    #

    echo "Fetching origin..."

    if ! git fetch origin; then

        echo "WARNING: Could not fetch origin."
        return 2

    fi


    #
    # The target branch may not exist remotely yet.
    # In that case there is nothing to merge.
    #

    if ! git show-ref \
        --verify \
        --quiet "$remote_ref"; then

        return 1

    fi


    #
    # If origin/<branch> is an ancestor of HEAD, local HEAD already
    # contains all remote commits.
    #
    # Otherwise the remote has history that local HEAD does not contain,
    # so this repository needs to be merged/rebased before committing.
    #

    if git merge-base \
        --is-ancestor \
        "$remote_ref" \
        HEAD; then

        return 1
    fi


    return 0
}


preflight_repository()
{
    local directory="$1"
    local root_relative_path="$2"
    local configured_branch="${3:-}"

    local git_root
    local current_remote


    if [ -z "$directory" ]; then
        return 1
    fi


    pushd "$directory" || return 1


    git_root=$(git rev-parse \
        --show-toplevel \
        2>/dev/null || true)

    if [ -z "$git_root" ]; then

        popd
        return 1

    fi


    cd "$git_root" || {

        popd
        return 1

    }


    echo
    echo "Preflight:"
    echo "   $git_root"


    #
    # Check this ca2 repository against its remote branch.
    #
    # Do not add the root repository itself to commit_pending_merges.txt;
    # the requested file contains submodule paths.
    #

    if [ -n "$root_relative_path" ]; then

        current_remote=$(git remote get-url \
            origin \
            2>/dev/null || true)

        if is_owned_remote "$current_remote"; then

            repository_requires_merge "$configured_branch"

            merge_status=$?

            if [ "$merge_status" -eq 0 ]; then

                echo "PENDING MERGE:"
                echo "   $root_relative_path"

                append_pending_merge "$root_relative_path"

            elif [ "$merge_status" -eq 2 ]; then

                echo "Could not determine remote state for:"
                echo "   $root_relative_path"

            fi

        fi

    fi


    #
    # Recursively inspect ca2 submodules.
    #

    if [ -f .gitmodules ]; then

        while IFS=' ' read -r key submodule_path; do

            if [ -z "${key:-}" ] ||
               [ -z "${submodule_path:-}" ]; then

                continue

            fi


            local submodule_name
            local submodule_url
            local submodule_branch
            local child_relative_path


            submodule_name="${key#submodule.}"
            submodule_name="${submodule_name%.path}"


            submodule_url=$(git config \
                --file .gitmodules \
                --get "submodule.${submodule_name}.url" \
                2>/dev/null || true)


            submodule_branch=$(git config \
                --file .gitmodules \
                --get "submodule.${submodule_name}.branch" \
                2>/dev/null || true)


            #
            # Only recurse into ca2-owned repositories.
            #

            if ! is_owned_remote "$submodule_url"; then
                continue
            fi


            if [ ! -d "$submodule_path" ]; then
                continue
            fi


            if ! git -C "$submodule_path" \
                rev-parse \
                --is-inside-work-tree \
                >/dev/null 2>&1; then

                continue

            fi


            if [ -z "$root_relative_path" ]; then

                child_relative_path="$submodule_path"

            else

                child_relative_path="$root_relative_path/$submodule_path"

            fi


            preflight_repository \
                "$submodule_path" \
                "$child_relative_path" \
                "$submodule_branch"


        done < <(
            git config \
                --file .gitmodules \
                --get-regexp '^submodule\..*\.path$' \
                2>/dev/null || true
        )

    fi


    popd

    return 0
}


process_repository()
{
    local directory="$1"
    local allow_push="$2"
    local configured_branch="${3:-}"

    local git_root
    local current_remote
    local push_branch


    if [ -z "$directory" ]; then

        echo "ERROR: Empty repository path."
        return 1

    fi


    if [ ! -d "$directory" ]; then

        echo "Directory does not exist:"
        echo "   $directory"

        return 1

    fi


    pushd "$directory" || return 1


    git_root=$(git rev-parse \
        --show-toplevel \
        2>/dev/null || true)

    if [ -z "$git_root" ]; then

        echo "Not a Git repository:"
        echo "   $directory"

        popd
        return 1

    fi


    cd "$git_root" || {

        popd
        return 1

    }


    echo
    echo "============================================================"
    echo "Processing:"
    echo "   $git_root"
    echo "============================================================"


    #
    # Children first.
    #

    if [ -f .gitmodules ]; then

        while IFS=' ' read -r key submodule_path; do

            if [ -z "${key:-}" ] ||
               [ -z "${submodule_path:-}" ]; then

                continue

            fi


            local submodule_name
            local submodule_url
            local submodule_branch


            submodule_name="${key#submodule.}"
            submodule_name="${submodule_name%.path}"


            submodule_url=$(git config \
                --file .gitmodules \
                --get "submodule.${submodule_name}.url" \
                2>/dev/null || true)


            submodule_branch=$(git config \
                --file .gitmodules \
                --get "submodule.${submodule_name}.branch" \
                2>/dev/null || true)


            if [ ! -d "$submodule_path" ]; then

                echo "Submodule is not checked out:"
                echo "   $submodule_path"

                continue

            fi


            if ! git -C "$submodule_path" \
                rev-parse \
                --is-inside-work-tree \
                >/dev/null 2>&1; then

                continue

            fi


            if is_owned_remote "$submodule_url"; then

                echo
                echo "Processing ca2 submodule:"
                echo "   $submodule_path"

                if ! process_repository \
                    "$submodule_path" \
                    "yes" \
                    "$submodule_branch"; then

                    echo "ERROR processing:"
                    echo "   $submodule_path"

                    popd
                    return 1

                fi

            else

                echo
                echo "External submodule:"
                echo "   $submodule_path"
                echo "Not committing or pushing it."

            fi


            #
            # Record whatever commit the submodule now points to.
            #

            git add -- "$submodule_path"


        done < <(
            git config \
                --file .gitmodules \
                --get-regexp '^submodule\..*\.path$' \
                2>/dev/null || true
        )

    fi


    echo
    echo "Staging all changes."

    git add -A -- .


    if git diff --cached --quiet; then

        echo "No changes to commit."

    else

        if [ ! -f "$DEDICATORY_FILE" ]; then

            echo "ERROR: Commit message file does not exist:"
            echo "   $DEDICATORY_FILE"

            popd
            return 1

        fi


        echo "Committing changes."

        if ! git commit \
            -F "$DEDICATORY_FILE"; then

            echo "ERROR: Commit failed:"
            echo "   $git_root"

            popd
            return 1

        fi

    fi


    if [ "$allow_push" != "yes" ]; then

        popd
        return 0

    fi


    current_remote=$(git remote get-url \
        origin \
        2>/dev/null || true)

    if [ -z "$current_remote" ]; then

        echo "No origin remote. Nothing to push."

        popd
        return 0

    fi


    push_branch=$(get_push_branch "$configured_branch")


    echo "Pushing HEAD to origin/$push_branch."


    if ! git push \
        origin \
        "HEAD:${push_branch}"; then

        echo
        echo "ERROR: Push failed:"
        echo "   $git_root"
        echo
        echo "Target:"
        echo "   origin/$push_branch"

        popd
        return 1

    fi


    popd

    return 0
}


#
# Find the root repository.
#

if [ $# -ge 1 ]; then

    BASEDIR="$1"

else

    BASEDIR=$(git rev-parse \
        --show-toplevel \
        2>/dev/null || true)

fi


if [ -z "${BASEDIR:-}" ]; then

    echo "Current directory is not inside a Git repository."
    exit 1

fi


if [ ! -d "$BASEDIR" ]; then

    echo "Directory does not exist:"
    echo "   $BASEDIR"

    exit 1

fi


pushd "$BASEDIR" || exit 1

BASEDIR=$(git rev-parse \
    --show-toplevel \
    2>/dev/null || true)

popd


if [ -z "$BASEDIR" ]; then

    echo "Specified directory is not inside a Git repository."
    exit 1

fi


#
# commit_pending_merges.txt always lives at the root of the repository
# from which this script was started.
#

ROOT_PENDING_FILE="$BASEDIR/$PENDING_MERGES_FILE"


#
# Start with a fresh file.
#

: > "$ROOT_PENDING_FILE"


echo
echo "Checking ca2 submodules for pending remote merges..."
echo


preflight_repository \
    "$BASEDIR" \
    "" \
    ""


#
# If any pending merge was detected, stop BEFORE committing anything.
#

if [ -s "$ROOT_PENDING_FILE" ]; then

    echo
    echo "============================================================"
    echo "Commit aborted."
    echo
    echo "The following ca2 submodules need to be merged/rebased first:"
    echo

    cat "$ROOT_PENDING_FILE"

    echo
    echo "List written to:"
    echo "   $ROOT_PENDING_FILE"
    echo "============================================================"

    exit 2

fi


#
# No pending merges.
#
# Remove the empty file so it doesn't itself become a repository change.
#
# If you prefer commit_pending_merges.txt to always exist, remove this rm.
#

rm -f "$ROOT_PENDING_FILE"


echo
echo "No pending remote merges detected."
echo "Starting recursive commit and push."
echo


process_repository \
    "$BASEDIR" \
    "yes" \
    ""

