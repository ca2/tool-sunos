#!/usr/bin/env python3
"""Cycle the XKB keyboard sources configured in GNOME."""
import ast
import subprocess
import sys

SCHEMA = "org.gnome.desktop.input-sources"

def run(*args):
    return subprocess.check_output(args, text=True).strip()

def setting(key):
    value = run("gsettings", "get", SCHEMA, key)
    # Empty GVariant arrays can carry a type annotation.
    if value.startswith("@"):
        value = value.split(" ", 1)[1]
    return ast.literal_eval(value)

try:
    sources = setting("sources")
    layouts = [(i, source.partition("+")[0], source.partition("+")[2])
               for i, (kind, source) in enumerate(sources) if kind == "xkb"]
    if not layouts:
        raise RuntimeError("No XKB layouts configured in GNOME Settings")
    config = dict(line.split(":", 1) for line in run("/usr/bin/setxkbmap", "-query").splitlines() if ":" in line)
    active = (config.get("layout", "").strip(), config.get("variant", "").strip())
    index = next((n for n, (_, layout, variant) in enumerate(layouts)
                  if (layout, variant) == active), None)
    if index is None:
        # Recover from missing/malformed XKB properties using GNOME's index.
        current = run("gsettings", "get", SCHEMA, "current").split()[-1]
        index = next((n for n, item in enumerate(layouts) if item[0] == int(current)), -1)
    source_index, layout, variant = layouts[(index + 1) % len(layouts)]
    options = setting("xkb-options")
    if "lv3:ralt_switch" not in options:
        options.append("lv3:ralt_switch")
    subprocess.check_call(["/usr/bin/setxkbmap", "-rules", "base", "-model",
        config.get("model", "sun_type6_usb").strip() or "sun_type6_usb",
        "-layout", layout, "-variant", variant, "-option", "", "-option", ",".join(options)])
    subprocess.check_call(["gsettings", "set", SCHEMA, "current", str(source_index)])
    description = layout + (" (" + variant + ")" if variant else "")
    print("Keyboard layout: " + description)
except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
    print("toggle-layout: " + str(error), file=sys.stderr)
    sys.exit(1)
