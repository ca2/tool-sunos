#!/usr/bin/env bash

set -u


#
# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------
#

MERGE_TOOL="${MERGE_TOOL:-meld}"

PENDING_FILE="commit_pending_merges.txt"
DEDICATORY_FILE="$HOME/dedicatory.txt"

OWNED_REMOTE_REGEX='github\.com[:/](ca2|cpp-port)/'


ERROR_COLOR=""
SUCCESS_COLOR=""
ERROR_RESET=""
SUCCESS_RESET=""


if [ -z "${NO_COLOR+x}" ] && [ "${TERM:-}" != "dumb" ]; then

    if [ -t 2 ]; then

        ERROR_COLOR=$'\033[1;31m'
        ERROR_RESET=$'\033[0m'

    fi

    if [ -t 1 ]; then

        SUCCESS_COLOR=$'\033[1;34m'
        SUCCESS_RESET=$'\033[0m'

    fi

fi


print_error()
{

    printf '%s%s%s\n' \
        "$ERROR_COLOR" \
        "$*" \
        "$ERROR_RESET" >&2

}


print_success()
{

    printf '%s%s%s\n' \
        "$SUCCESS_COLOR" \
        "$*" \
        "$SUCCESS_RESET"

}


#
# ----------------------------------------------------------------------
# Utility functions
# ----------------------------------------------------------------------
#

pushd()
{

    command pushd "$@" > /dev/null

}


popd()
{

    command popd "$@" > /dev/null

}


read_answer()
{

    local prompt="${1:-}"

    if [ -n "$prompt" ]; then

        printf '%s' "$prompt"

    fi


    if ! IFS= read -r REPLY; then

        echo
        print_error "ERROR: Could not read interactive input."

        return 1

    fi


    return 0

}


get_branch()
{

    local configured_branch="${1:-}"
    local branch


    if [ -n "$configured_branch" ] &&
       [ "$configured_branch" != "." ]; then

        printf '%s\n' "$configured_branch"

        return 0

    fi


    branch=$(git symbolic-ref \
        --quiet \
        --short HEAD \
        2>/dev/null || true)


    if [ -n "$branch" ]; then

        printf '%s\n' "$branch"

        return 0

    fi


    branch=$(git symbolic-ref \
        --quiet \
        --short refs/remotes/origin/HEAD \
        2>/dev/null || true)


    if [ -n "$branch" ]; then

        printf '%s\n' "${branch#origin/}"

        return 0

    fi


    if git show-ref \
        --verify \
        --quiet refs/remotes/origin/main; then

        printf '%s\n' "main"

        return 0

    fi


    if git show-ref \
        --verify \
        --quiet refs/remotes/origin/master; then

        printf '%s\n' "master"

        return 0

    fi


    printf '%s\n' "main"

}


is_owned_remote()
{

    local url="$1"

    [[ "$url" =~ $OWNED_REMOTE_REGEX ]]

}


get_submodule_remote_url()
{

    local submodule_name="$1"
    local submodule_path="$2"
    local url


    url=$(git config \
        --get "submodule.${submodule_name}.url" \
        2>/dev/null || true)


    if [ -z "$url" ] &&
       git -C "$submodule_path" rev-parse \
        --is-inside-work-tree \
        >/dev/null 2>&1; then

        url=$(git -C "$submodule_path" remote get-url \
            origin \
            2>/dev/null || true)

    fi


    if [ -z "$url" ] &&
       [ -f .gitmodules ]; then

        url=$(git config \
            --file .gitmodules \
            --get "submodule.${submodule_name}.url" \
            2>/dev/null || true)

    fi


    printf '%s\n' "$url"

}


commit_is_available_from_origin()
{

    local directory="$1"
    local commit="$2"
    local remote_tags


    if ! git -C "$directory" fetch \
        --prune \
        origin \
        '+refs/heads/*:refs/remotes/origin/*'; then

        return 1

    fi


    if git -C "$directory" for-each-ref \
        --format='%(refname)' \
        --contains="$commit" \
        refs/remotes/origin |
        grep -q .; then

        return 0

    fi


    remote_tags=$(git -C "$directory" ls-remote \
        --tags \
        origin \
        2>/dev/null || true)


    if printf '%s\n' "$remote_tags" |
        awk '{print $1}' |
        grep -Fqx -- "$commit"; then

        return 0

    fi


    return 1

}


verify_external_submodules()
{

    local key
    local submodule_path
    local submodule_name
    local submodule_url
    local commit
    local worktree_commit


    if [ ! -f .gitmodules ]; then

        return 0

    fi


    while IFS=' ' read -r key submodule_path; do

        if [ -z "${key:-}" ] ||
           [ -z "${submodule_path:-}" ]; then

            continue

        fi


        submodule_name="${key#submodule.}"
        submodule_name="${submodule_name%.path}"

        submodule_url=$(get_submodule_remote_url \
            "$submodule_name" \
            "$submodule_path")


        if is_owned_remote "$submodule_url"; then

            continue

        fi


        if ! git -C "$submodule_path" rev-parse \
            --is-inside-work-tree \
            >/dev/null 2>&1; then

            echo
            print_error "ERROR: Cannot validate uninitialized external submodule:"
            echo "   $submodule_path"

            return 1

        fi


        commit=$(git ls-files \
            --stage \
            -- "$submodule_path" |
            awk '$1 == "160000" { print $2; exit }')


        if [ -z "$commit" ]; then

            echo
            print_error "ERROR: Could not read staged gitlink for:"
            echo "   $submodule_path"

            return 1

        fi


        echo "Verifying external submodule commit is published:"
        echo "   $submodule_path"
        echo "   $commit"


        if ! commit_is_available_from_origin \
            "$submodule_path" \
            "$commit"; then

            echo
            print_error "ERROR: Refusing to commit an external gitlink that"
            echo "is not reachable from any advertised origin ref:"
            echo "   Path   : $submodule_path"
            echo "   URL    : $submodule_url"
            echo "   Commit : $commit"

            return 1

        fi


        worktree_commit=$(git -C "$submodule_path" rev-parse HEAD)


        if [ "$worktree_commit" != "$commit" ]; then

            echo "Verifying external submodule worktree HEAD is published:"
            echo "   $submodule_path"
            echo "   $worktree_commit"


            if ! commit_is_available_from_origin \
                "$submodule_path" \
                "$worktree_commit"; then

                echo
                print_error "ERROR: Refusing to stage an external submodule"
                echo "worktree HEAD that is not advertised by origin:"
                echo "   Path   : $submodule_path"
                echo "   URL    : $submodule_url"
                echo "   Commit : $worktree_commit"

                return 1

            fi

        fi


    done < <(
        git config \
            --file .gitmodules \
            --get-regexp '^submodule\..*\.path$' \
            2>/dev/null || true
    )


    return 0

}


#
# ----------------------------------------------------------------------
# Conflict utility functions
# ----------------------------------------------------------------------
#

has_conflicts()
{

    git diff \
        --name-only \
        --diff-filter=U |
        grep -q .

}


get_conflict_count()
{

    git diff \
        --name-only \
        --diff-filter=U |
        sed '/^[[:space:]]*$/d' |
        wc -l |
        tr -d '[:space:]'

}


get_first_conflict()
{

    git diff \
        --name-only \
        --diff-filter=U |
        sed -n '1p'

}


is_file_still_conflicted()
{

    local filename="$1"


    git diff \
        --name-only \
        --diff-filter=U \
        -- "$filename" |
        grep -q .

}


show_conflicts()
{

    local count

    count=$(get_conflict_count)


    echo
    echo "Unresolved conflicts: $count"
    echo


    git diff \
        --name-only \
        --diff-filter=U |
        sed 's/^/   /'


    echo

}


ensure_mergetool_available()
{

    if command -v "$MERGE_TOOL" >/dev/null 2>&1; then

        return 0

    fi


    echo
    print_error "ERROR: Merge conflicts require a merge tool, but this"
    echo "configured tool was not found:"
    echo
    echo "   $MERGE_TOOL"
    echo
    echo "You can choose another tool, for example:"
    echo
    echo "   MERGE_TOOL=vimdiff merge"
    echo
    echo "or:"
    echo
    echo "   MERGE_TOOL=kdiff3 merge"

    return 1

}


#
# ----------------------------------------------------------------------
# Pending merge file
# ----------------------------------------------------------------------
#

remove_from_pending_file()
{

    local relative_path="$1"
    local temporary_file


    temporary_file="${PENDING_PATH}.tmp.$$"


    awk -v target="$relative_path" '

        $0 != target {
            print
        }

    ' "$PENDING_PATH" > "$temporary_file"


    mv "$temporary_file" "$PENDING_PATH"

}


#
# ----------------------------------------------------------------------
# Submodule conflict support
# ----------------------------------------------------------------------
#

is_submodule_conflict()
{

    local filename="$1"


    git ls-files \
        -u \
        -- "$filename" |
        awk '

            $1 == "160000" {
                found = 1
            }

            END {
                exit !found
            }

        '

}


get_submodule_conflict_sha()
{

    local filename="$1"
    local stage="$2"


    git ls-files \
        -u \
        -- "$filename" |
        awk -v wanted_stage="$stage" '

            $1 == "160000" && $3 == wanted_stage {
                print $2
                exit
            }

        '

}


submodule_is_initialized()
{

    local filename="$1"


    git -C "$filename" rev-parse \
        --is-inside-work-tree \
        >/dev/null 2>&1

}


submodule_commit_exists()
{

    local filename="$1"
    local commit="$2"


    git -C "$filename" cat-file \
        -e "${commit}^{commit}" \
        2>/dev/null

}


align_submodule_worktree()
{

    local filename="$1"
    local selected_commit="$2"

    local worktree_commit
    local worktree_status


    if ! submodule_is_initialized "$filename"; then

        #
        # There is no checked-out worktree to align.
        #

        return 0

    fi


    worktree_commit=$(git -C "$filename" rev-parse HEAD)


    if [ "$worktree_commit" = "$selected_commit" ]; then

        return 0

    fi


    worktree_status=$(git -C "$filename" status \
        --porcelain \
        --untracked-files=all)


    if [ -n "$worktree_status" ]; then

        echo
        print_error "ERROR: Refusing to move a dirty submodule worktree:"
        echo "   $filename"
        echo
        echo "Current submodule HEAD:"
        echo "   $worktree_commit"
        echo
        echo "Selected merge commit:"
        echo "   $selected_commit"
        echo
        echo "The submodule contains local changes:"
        echo

        printf '%s\n' "$worktree_status" |
            sed 's/^/   /'

        echo
        echo "Commit, stash, or otherwise handle those changes first."

        return 1

    fi


    if ! submodule_commit_exists \
        "$filename" \
        "$selected_commit"; then

        echo
        echo "Selected commit is not available locally."
        echo "Fetching submodule origin:"
        echo "   $filename"


        if ! git -C "$filename" fetch \
            --prune \
            origin; then

            echo
            print_error "ERROR: Could not fetch submodule origin."

            return 1

        fi

    fi


    if ! submodule_commit_exists \
        "$filename" \
        "$selected_commit"; then

        echo
        print_error "ERROR: Selected commit is still unavailable:"
        echo "   $selected_commit"
        echo
        echo "Submodule:"
        echo "   $filename"

        return 1

    fi


    echo
    echo "Updating submodule worktree:"
    echo "   $filename"
    echo
    echo "Checking out:"
    echo "   $selected_commit"


    if ! git -C "$filename" checkout \
        --detach \
        "$selected_commit"; then

        echo
        print_error "ERROR: Could not move submodule worktree to selected commit."

        return 1

    fi


    return 0

}


resolve_submodule_conflict()
{

    local filename="$1"

    local base_commit
    local local_commit
    local remote_commit
    local selected_commit
    local answer


    base_commit=$(get_submodule_conflict_sha \
        "$filename" \
        1)

    local_commit=$(get_submodule_conflict_sha \
        "$filename" \
        2)

    remote_commit=$(get_submodule_conflict_sha \
        "$filename" \
        3)


    if [ -z "$local_commit" ] ||
       [ -z "$remote_commit" ]; then

        echo
        print_error "ERROR: Could not determine both sides of submodule conflict:"
        echo "   $filename"
        echo
        echo "Unmerged index entries:"

        git ls-files \
            -u \
            -- "$filename" |
            sed 's/^/   /'

        return 1

    fi


    echo
    echo "============================================================"
    echo "SUBMODULE MERGE CONFLICT"
    echo "============================================================"
    echo
    echo "Submodule:"
    echo "   $filename"
    echo


    if [ -n "$base_commit" ]; then

        echo "Merge base:"
        echo "   $base_commit"
        echo

    fi


    echo "Local / ours:"
    echo "   $local_commit"
    echo
    echo "Remote / theirs:"
    echo "   $remote_commit"
    echo
    echo "Actions:"
    echo
    echo "   l       Use local / ours"
    echo "   r       Use remote / theirs"
    echo "   q       Stop the merge wizard"
    echo


    while true; do

        if ! read_answer "> "; then

            return 1

        fi

        answer="$REPLY"


        case "$answer" in

            l|L)

                selected_commit="$local_commit"

                break
                ;;


            r|R)

                selected_commit="$remote_commit"

                break
                ;;


            q|Q)

                echo
                echo "Merge wizard stopped by user."

                return 1
                ;;


            *)

                echo
                echo "Please enter l, r, or q."
                echo
                ;;

        esac

    done


    #
    # Align the initialized submodule first.
    #
    # If this cannot be done safely, do not modify the parent index.
    #

    if ! align_submodule_worktree \
        "$filename" \
        "$selected_commit"; then

        return 1

    fi


    #
    # Replace unmerged index stages with one normal gitlink entry.
    #

    if ! git update-index \
        --cacheinfo \
        "160000,$selected_commit,$filename"; then

        echo
        print_error "ERROR: Could not stage selected submodule gitlink:"
        echo "   $filename"
        echo "   $selected_commit"

        return 1

    fi


    if is_file_still_conflicted "$filename"; then

        echo
        print_error "ERROR: Submodule is still marked as conflicted:"
        echo "   $filename"

        return 1

    fi


    echo
    print_success "Resolved submodule:"
    echo "   $filename"
    echo
    echo "Selected commit:"
    echo "   $selected_commit"


    return 0

}


#
# ----------------------------------------------------------------------
# Commit local changes generated by child merges.
# ----------------------------------------------------------------------
#

commit_propagated_child_changes()
{

    local relative_path="$1"


    if git diff --quiet &&
       git diff --cached --quiet; then

        return 0

    fi


    echo
    echo "Local changes exist before merging:"
    echo "   $relative_path"
    echo


    git status --short


    if [ ! -f "$DEDICATORY_FILE" ]; then

        echo
        print_error "ERROR: Commit message file does not exist:"
        echo "   $DEDICATORY_FILE"

        return 1

    fi


    echo
    echo "Recording merged child submodule references before"
    echo "merging this repository."


    if ! verify_external_submodules; then

        return 1

    fi


    git add -A


    if ! verify_external_submodules; then

        return 1

    fi


    if git diff --cached --quiet; then

        return 0

    fi


    if ! git commit \
        -F "$DEDICATORY_FILE"; then

        echo
        print_error "ERROR: Could not commit propagated child changes."

        return 1

    fi


    return 0

}


#
# ----------------------------------------------------------------------
# Conflict wizard
# ----------------------------------------------------------------------
#

resolve_conflicts_wizard()
{

    local repository_relative_path="$1"

    local conflict_file
    local conflict_count
    local answer
    local mergetool_result


    while has_conflicts; do

        conflict_count=$(get_conflict_count)
        conflict_file=$(get_first_conflict)


        if [ -z "$conflict_file" ]; then

            echo
            print_error "ERROR: Git reports conflicts but no conflicted file"
            echo "could be determined."

            return 1

        fi


        #
        # A gitlink conflict is not a normal file conflict.
        #

        if is_submodule_conflict "$conflict_file"; then

            echo
            echo "Repository:"
            echo "   $repository_relative_path"
            echo
            echo "Conflicts remaining:"
            echo "   $conflict_count"


            if ! resolve_submodule_conflict \
                "$conflict_file"; then

                return 1

            fi


            continue

        fi


        #
        # Ordinary file conflict.
        #

        echo
        echo "============================================================"
        echo "MERGE CONFLICT"
        echo "============================================================"
        echo
        echo "Repository:"
        echo "   $repository_relative_path"
        echo
        echo "Conflicts remaining:"
        echo "   $conflict_count"
        echo
        echo "Next file:"
        echo "   $conflict_file"
        echo
        echo "Actions:"
        echo
        echo "   Enter   Open this file in $MERGE_TOOL"
        echo "   s       Show all remaining conflicts"
        echo "   q       Stop the merge wizard"
        echo


        if ! read_answer "> "; then

            return 1

        fi

        answer="$REPLY"


        case "$answer" in

            q|Q)

                echo
                echo "Merge wizard stopped by user."

                return 1
                ;;


            s|S)

                show_conflicts

                continue
                ;;


            "")

                ;;


            *)

                echo
                echo "Unknown command."

                continue
                ;;

        esac


        if ! ensure_mergetool_available; then

            return 1

        fi


        echo
        echo "Opening:"
        echo "   $conflict_file"
        echo
        echo "Using:"
        echo "   $MERGE_TOOL"
        echo


        git mergetool \
            --tool="$MERGE_TOOL" \
            --no-prompt \
            -- "$conflict_file"

        mergetool_result=$?


        if is_file_still_conflicted "$conflict_file"; then

            echo
            echo "The file is still conflicted:"
            echo "   $conflict_file"


            if [ "$mergetool_result" -ne 0 ]; then

                echo
                echo "The merge tool also returned an error."

            fi


            echo
            echo "The same file will be presented again."

            continue

        fi


        git add -- "$conflict_file"


        echo
        print_success "Resolved:"
        echo "   $conflict_file"

    done


    echo
    print_success "All conflicts in this repository have been resolved."

    return 0

}


#
# ----------------------------------------------------------------------
# Merge one repository
# ----------------------------------------------------------------------
#

merge_repository()
{

    local repository="$1"
    local relative_path="$2"

    local branch
    local merge_result


    echo
    echo "################################################################"
    echo "Repository:"
    echo "   $relative_path"
    echo
    echo "Path:"
    echo "   $repository"
    echo "################################################################"
    echo


    pushd "$repository" || return 1


    if ! git rev-parse \
        --is-inside-work-tree \
        >/dev/null 2>&1; then

        print_error "ERROR: Not a Git repository:"
        echo "   $repository"

        popd

        return 1

    fi


    #
    # An existing unfinished merge takes priority.
    #

    if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then

        echo "An unfinished merge already exists."


        if has_conflicts; then

            if ! resolve_conflicts_wizard "$relative_path"; then

                popd

                return 1

            fi

        fi


        if has_conflicts; then

            echo
            print_error "ERROR: Unresolved conflicts remain."

            popd

            return 1

        fi


        #
        # Do not run git add -A here.
        #
        # Conflict files and gitlinks have already been staged explicitly.
        # A blanket git add -A could replace a selected gitlink with the
        # current submodule worktree HEAD.
        #

        if ! verify_external_submodules; then

            popd

            return 1

        fi


        echo
        echo "Completing existing merge."


        if ! git commit --no-edit; then

            echo
            print_error "ERROR: Could not complete existing merge."

            popd

            return 1

        fi


        popd

        return 0

    fi


    #
    # A previously merged child repository may have changed its gitlink
    # in this parent. Commit that propagation before merging this
    # repository's own remote branch.
    #

    if ! commit_propagated_child_changes "$relative_path"; then

        popd

        return 1

    fi


    branch=$(get_branch)


    echo
    echo "Target remote branch:"
    echo "   origin/$branch"


    echo
    echo "Fetching origin..."


    if ! git fetch origin; then

        echo
        print_error "ERROR: Could not fetch origin."

        popd

        return 1

    fi


    if ! git show-ref \
        --verify \
        --quiet \
        "refs/remotes/origin/$branch"; then

        echo
        print_error "ERROR: Remote branch does not exist:"
        echo "   origin/$branch"

        popd

        return 1

    fi


    #
    # The pending list may be stale. If the remote branch is already
    # contained in HEAD, nothing remains to merge.
    #

    if git merge-base \
        --is-ancestor \
        "origin/$branch" \
        HEAD; then

        echo
        echo "No merge is currently required."
        echo "HEAD already contains origin/$branch."

        popd

        return 0

    fi


    echo
    echo "Merging:"
    echo "   origin/$branch"
    echo "into current HEAD..."


    git merge \
        --no-commit \
        --no-edit \
        "origin/$branch"

    merge_result=$?


    #
    # Clean automatic merge.
    #

    if [ "$merge_result" -eq 0 ]; then

        git add -A


        if ! verify_external_submodules; then

            popd

            return 1

        fi


        if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then

            echo
            echo "Completing validated merge commit..."


            if ! git commit --no-edit; then

                echo
                print_error "ERROR: Could not complete merge commit."

                popd

                return 1

            fi

        fi


        echo
        print_success "Merge completed automatically with no conflicts."


        popd

        return 0

    fi


    #
    # Non-zero merge result without unmerged index entries means some
    # other error occurred.
    #

    if ! has_conflicts; then

        echo
        print_error "ERROR: git merge failed but Git reports no file conflicts."
        echo
        echo "Inspect manually:"
        echo "   $repository"

        popd

        return 1

    fi


    show_conflicts


    echo "Git automatically merged everything it could."
    echo "Only unresolved files will be shown by the wizard."


    if ! resolve_conflicts_wizard "$relative_path"; then

        popd

        return 1

    fi


    if has_conflicts; then

        echo
        print_error "ERROR: unresolved conflicts remain."

        popd

        return 1

    fi


    #
    # Do not run git add -A here.
    #
    # The conflict wizard explicitly stages regular files and explicitly
    # installs the selected gitlink for submodule conflicts.
    #

    if ! verify_external_submodules; then

        popd

        return 1

    fi


    echo
    echo "Completing merge commit..."


    if ! git commit --no-edit; then

        echo
        print_error "ERROR: Could not complete merge commit."

        popd

        return 1

    fi


    echo
    print_success "Merge completed successfully."


    popd

    return 0

}


#
# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------
#

ROOT=$(git rev-parse \
    --show-toplevel \
    2>/dev/null || true)


if [ -z "$ROOT" ]; then

    print_error "ERROR: Current directory is not inside a Git repository."

    exit 1

fi


PENDING_PATH="$ROOT/$PENDING_FILE"


if [ ! -f "$PENDING_PATH" ]; then

    print_success "No pending merge file exists; nothing to do:"
    echo
    echo "   $PENDING_PATH"

    exit 0

fi


if [ ! -s "$PENDING_PATH" ]; then

    print_success "Pending merge file is empty; nothing to do:"
    echo
    echo "   $PENDING_PATH"

    exit 0

fi


echo
echo "============================================================"
echo "ca2 Guided Merge Wizard"
echo "============================================================"
echo
echo "Merge tool (used only for ordinary file conflicts):"
echo "   $MERGE_TOOL"
echo
echo "Pending merge file:"
echo "   $PENDING_PATH"
echo
echo "Repositories:"
echo

sed 's/^/   /' "$PENDING_PATH"

echo


#
# Sort bottom-to-top.
#
# Deeper repositories must be merged before their parents.
#
# Root "." is forced to the very end.
#

SORTED_PATHS=$(
    awk '

        NF {

            path = $0

            copy = path

            depth = gsub(/\//, "/", copy)

            if (path == ".")
                depth = -1

            print depth "\t" path

        }

    ' "$PENDING_PATH" |
    sort -rn -k1,1 |
    cut -f2-
)


failed=0


#
# IMPORTANT:
#
# Feed SORTED_PATHS through file descriptor 3 rather than stdin.
#
# Interactive functions inside merge_repository() must retain normal
# terminal stdin so that l/r/q and merge-wizard prompts work correctly.
#

while IFS= read -r relative_path <&3; do

    if [ -z "$relative_path" ]; then

        continue

    fi


    if [ "$relative_path" = "." ]; then

        repository="$ROOT"

    else

        repository="$ROOT/$relative_path"

    fi


    echo
    echo "Next repository:"
    echo "   $relative_path"


    if [ ! -d "$repository" ]; then

        echo
        print_error "ERROR: Repository directory does not exist:"
        echo "   $repository"

        failed=1

        break

    fi


    if ! merge_repository \
        "$repository" \
        "$relative_path"; then

        echo
        print_error "============================================================"
        print_error "Merge wizard stopped because of an error."
        echo
        echo "Repository:"
        echo "   $relative_path"
        echo
        echo "Remaining pending repositories are still recorded in:"
        echo "   $PENDING_PATH"
        print_error "============================================================"

        failed=1

        break

    fi


    remove_from_pending_file "$relative_path"


    echo
    echo "Completed:"
    echo "   $relative_path"

done 3<<< "$SORTED_PATHS"


if [ "$failed" -ne 0 ]; then

    exit 1

fi


if [ ! -s "$PENDING_PATH" ]; then

    rm -f "$PENDING_PATH"

fi


echo
print_success "============================================================"
print_success "All pending merges were completed successfully."
print_success "============================================================"
echo
echo "Run commit again to record any final parent gitlink changes"
echo "and push the complete repository hierarchy."
