```bash
#!/usr/bin/env bash

set -u


#
# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------
#

MERGE_TOOL="${MERGE_TOOL:-meld}"

PENDING_FILE="commit_pending_merges.txt"
DEDICATORY_FILE="$HOME/dedicatory.txt"


#
# ----------------------------------------------------------------------
# Utility functions
# ----------------------------------------------------------------------
#

pushd()
{
    command pushd "$@" > /dev/null
}


popd()
{
    command popd "$@" > /dev/null
}


get_branch()
{
    local branch


    branch=$(git symbolic-ref \
        --quiet \
        --short HEAD \
        2>/dev/null || true)


    if [ -n "$branch" ]; then

        printf '%s\n' "$branch"

        return 0

    fi


    branch=$(git symbolic-ref \
        --quiet \
        --short refs/remotes/origin/HEAD \
        2>/dev/null || true)


    if [ -n "$branch" ]; then

        printf '%s\n' "${branch#origin/}"

        return 0

    fi


    if git show-ref \
        --verify \
        --quiet refs/remotes/origin/main; then

        printf '%s\n' "main"

        return 0

    fi


    if git show-ref \
        --verify \
        --quiet refs/remotes/origin/master; then

        printf '%s\n' "master"

        return 0

    fi


    printf '%s\n' "main"
}


has_conflicts()
{
    git diff \
        --name-only \
        --diff-filter=U |
        grep -q .
}


get_conflict_count()
{
    git diff \
        --name-only \
        --diff-filter=U |
        sed '/^[[:space:]]*$/d' |
        wc -l |
        tr -d '[:space:]'
}


get_first_conflict()
{
    git diff \
        --name-only \
        --diff-filter=U |
        sed -n '1p'
}


is_file_still_conflicted()
{
    local filename="$1"

    git diff \
        --name-only \
        --diff-filter=U \
        -- "$filename" |
        grep -q .
}


show_conflicts()
{
    local count

    count=$(get_conflict_count)


    echo
    echo "Unresolved conflicts: $count"
    echo


    git diff \
        --name-only \
        --diff-filter=U |
        sed 's/^/   /'


    echo
}


ensure_mergetool_available()
{
    if command -v "$MERGE_TOOL" >/dev/null 2>&1; then

        return 0

    fi


    echo
    echo "ERROR: Merge conflicts require a merge tool, but this"
    echo "configured tool was not found:"
    echo
    echo "   $MERGE_TOOL"
    echo
    echo "You can choose another tool, for example:"
    echo
    echo "   MERGE_TOOL=vimdiff merge"
    echo
    echo "or:"
    echo
    echo "   MERGE_TOOL=kdiff3 merge"

    return 1
}


remove_from_pending_file()
{
    local relative_path="$1"
    local temporary_file


    temporary_file="${PENDING_PATH}.tmp.$$"


    awk -v target="$relative_path" '

        $0 != target {
            print
        }

    ' "$PENDING_PATH" > "$temporary_file"


    mv "$temporary_file" "$PENDING_PATH"
}


#
# ----------------------------------------------------------------------
# Commit local changes generated by child merges.
#
# After a child repository changes HEAD, its parent sees a modified
# submodule gitlink. Before merging the parent, record that gitlink.
#
# The first commit run before this merge wizard should already have
# committed all ordinary source changes, so at this stage the expected
# changes are principally submodule pointers produced by completed
# child merges.
# ----------------------------------------------------------------------
#

commit_propagated_child_changes()
{
    local relative_path="$1"


    if git diff --quiet &&
       git diff --cached --quiet; then

        return 0

    fi


    echo
    echo "Local changes exist before merging:"
    echo "   $relative_path"
    echo


    git status --short


    if [ ! -f "$DEDICATORY_FILE" ]; then

        echo
        echo "ERROR: Commit message file does not exist:"
        echo "   $DEDICATORY_FILE"

        return 1

    fi


    echo
    echo "Recording merged child submodule references before"
    echo "merging this repository."


    git add -A


    if git diff --cached --quiet; then

        return 0

    fi


    if ! git commit \
        -F "$DEDICATORY_FILE"; then

        echo
        echo "ERROR: Could not commit propagated child changes."

        return 1

    fi


    return 0
}


#
# ----------------------------------------------------------------------
# Conflict wizard
# ----------------------------------------------------------------------
#

resolve_conflicts_wizard()
{
    local repository_relative_path="$1"

    local conflict_file
    local conflict_count
    local answer
    local mergetool_result


    ensure_mergetool_available || return 1


    while has_conflicts; do

        conflict_count=$(get_conflict_count)
        conflict_file=$(get_first_conflict)


        if [ -z "$conflict_file" ]; then

            echo
            echo "ERROR: Git reports conflicts but no conflicted file"
            echo "could be determined."

            return 1

        fi


        echo
        echo "============================================================"
        echo "MERGE CONFLICT"
        echo "============================================================"
        echo
        echo "Repository:"
        echo "   $repository_relative_path"
        echo
        echo "Conflicts remaining:"
        echo "   $conflict_count"
        echo
        echo "Next file:"
        echo "   $conflict_file"
        echo
        echo "Actions:"
        echo
        echo "   Enter   Open this file in $MERGE_TOOL"
        echo "   s       Show all remaining conflicts"
        echo "   q       Stop the merge wizard"
        echo


        printf "> "

        IFS= read -r answer


        case "$answer" in

            q|Q)

                echo
                echo "Merge wizard stopped by user."

                return 1
                ;;


            s|S)

                show_conflicts

                continue
                ;;


            "")

                ;;


            *)

                echo
                echo "Unknown command."

                continue
                ;;

        esac


        echo
        echo "Opening:"
        echo "   $conflict_file"
        echo
        echo "Using:"
        echo "   $MERGE_TOOL"
        echo


        git mergetool \
            --tool="$MERGE_TOOL" \
            --no-prompt \
            -- "$conflict_file"

        mergetool_result=$?


        if is_file_still_conflicted "$conflict_file"; then

            echo
            echo "The file is still conflicted:"
            echo "   $conflict_file"


            if [ "$mergetool_result" -ne 0 ]; then

                echo
                echo "The merge tool also returned an error."

            fi


            echo
            echo "The same file will be presented again."

            continue

        fi


        git add -- "$conflict_file"


        echo
        echo "Resolved:"
        echo "   $conflict_file"

    done


    echo
    echo "All conflicts in this repository have been resolved."

    return 0
}


#
# ----------------------------------------------------------------------
# Merge one repository
# ----------------------------------------------------------------------
#

merge_repository()
{
    local repository="$1"
    local relative_path="$2"

    local branch
    local merge_result


    echo
    echo "################################################################"
    echo "Repository:"
    echo "   $relative_path"
    echo
    echo "Path:"
    echo "   $repository"
    echo "################################################################"
    echo


    pushd "$repository" || return 1


    if ! git rev-parse \
        --is-inside-work-tree \
        >/dev/null 2>&1; then

        echo "ERROR: Not a Git repository:"
        echo "   $repository"

        popd

        return 1

    fi


    #
    # An existing merge takes priority.
    #

    if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then

        echo "An unfinished merge already exists."


        if has_conflicts; then

            if ! resolve_conflicts_wizard "$relative_path"; then

                popd
                return 1

            fi

        fi


        git add -A


        echo
        echo "Completing existing merge."


        if ! git commit --no-edit; then

            echo
            echo "ERROR: Could not complete existing merge."

            popd
            return 1

        fi


        popd

        return 0

    fi


    #
    # IMPORTANT:
    #
    # A previously merged child may have changed its gitlink in this
    # repository. Record that pointer before attempting this repository's
    # own remote merge.
    #

    if ! commit_propagated_child_changes "$relative_path"; then

        popd

        return 1

    fi


    branch=$(get_branch)


    echo
    echo "Target remote branch:"
    echo "   origin/$branch"


    echo
    echo "Fetching origin..."


    if ! git fetch origin; then

        echo
        echo "ERROR: Could not fetch origin."

        popd

        return 1

    fi


    if ! git show-ref \
        --verify \
        --quiet \
        "refs/remotes/origin/$branch"; then

        echo
        echo "ERROR: Remote branch does not exist:"
        echo "   origin/$branch"

        popd

        return 1

    fi


    #
    # It may have ceased to need a merge since the pending file was
    # generated.
    #

    if git merge-base \
        --is-ancestor \
        "origin/$branch" \
        HEAD; then

        echo
        echo "No merge is currently required."
        echo "HEAD already contains origin/$branch."

        popd

        return 0

    fi


    echo
    echo "Merging:"
    echo "   origin/$branch"
    echo "into current HEAD..."


    git merge \
        --no-edit \
        "origin/$branch"

    merge_result=$?


    if [ "$merge_result" -eq 0 ]; then

        echo
        echo "Merge completed automatically with no conflicts."

        popd

        return 0

    fi


    if ! has_conflicts; then

        echo
        echo "ERROR: git merge failed but Git reports no file conflicts."
        echo
        echo "Inspect manually:"
        echo "   $repository"

        popd

        return 1

    fi


    show_conflicts


    echo "Git automatically merged everything it could."
    echo "Only unresolved files will be shown by the wizard."


    if ! resolve_conflicts_wizard "$relative_path"; then

        popd

        return 1

    fi


    if has_conflicts; then

        echo
        echo "ERROR: unresolved conflicts remain."

        popd

        return 1

    fi


    git add -A


    echo
    echo "Completing merge commit..."


    if ! git commit --no-edit; then

        echo
        echo "ERROR: Could not complete merge commit."

        popd

        return 1

    fi


    echo
    echo "Merge completed successfully."


    popd

    return 0
}


#
# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------
#

ROOT=$(git rev-parse \
    --show-toplevel \
    2>/dev/null || true)


if [ -z "$ROOT" ]; then

    echo "Current directory is not inside a Git repository."

    exit 1

fi


PENDING_PATH="$ROOT/$PENDING_FILE"


if [ ! -f "$PENDING_PATH" ]; then

    echo "No pending merge file exists:"
    echo
    echo "   $PENDING_PATH"

    exit 0

fi


if [ ! -s "$PENDING_PATH" ]; then

    echo "Pending merge file is empty:"
    echo
    echo "   $PENDING_PATH"

    exit 0

fi


echo
echo "============================================================"
echo "ca2 Guided Merge Wizard"
echo "============================================================"
echo
echo "Merge tool (used only if conflicts occur):"
echo "   $MERGE_TOOL"
echo
echo "Pending merge file:"
echo "   $PENDING_PATH"
echo
echo "Repositories:"
echo

sed 's/^/   /' "$PENDING_PATH"

echo


#
# Sort bottom-to-top.
#
# "." has depth zero, so the root repository naturally comes last.
#

SORTED_PATHS=$(
    awk '

        NF {

            path = $0

            copy = path

            depth = gsub(/\//, "/", copy)

            #
            # Force root to the absolute bottom.
            #

            if (path == ".")
                depth = -1

            print depth "\t" path

        }

    ' "$PENDING_PATH" |
    sort -rn -k1,1 |
    cut -f2-
)


failed=0


while IFS= read -r relative_path; do

    if [ -z "$relative_path" ]; then
        continue
    fi


    if [ "$relative_path" = "." ]; then

        repository="$ROOT"

    else

        repository="$ROOT/$relative_path"

    fi


    echo
    echo "Next repository:"
    echo "   $relative_path"


    if [ ! -d "$repository" ]; then

        echo
        echo "ERROR: Repository directory does not exist:"
        echo "   $repository"

        failed=1

        break

    fi


    if ! merge_repository \
        "$repository" \
        "$relative_path"; then

        echo
        echo "============================================================"
        echo "Merge wizard stopped."
        echo
        echo "Repository:"
        echo "   $relative_path"
        echo
        echo "Remaining pending repositories are still recorded in:"
        echo "   $PENDING_PATH"
        echo "============================================================"

        failed=1

        break

    fi


    remove_from_pending_file "$relative_path"


    echo
    echo "Completed:"
    echo "   $relative_path"

done <<< "$SORTED_PATHS"


if [ "$failed" -ne 0 ]; then

    exit 1

fi


if [ ! -s "$PENDING_PATH" ]; then

    rm -f "$PENDING_PATH"

fi


echo
echo "============================================================"
echo "All pending merges were completed successfully."
echo "============================================================"
echo
echo "Run commit again to record any final parent gitlink changes"
echo "and push the complete repository hierarchy."
```
