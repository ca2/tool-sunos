# Refresh all fields even when a parent shell has already exported __SYSTEM.
if [ -r "$HOME/application/integration/code/.operating_system_summary" ]; then
   . "$HOME/application/integration/code/.operating_system_summary"
fi

export __SYSTEM
export __SYSTEM_FAMILY
export __SYSTEM_BRANCH
export __SYSTEM_RELEASE
export __SYSTEM_ARCHITECTURE
export __SYSTEM_SUDO_INSTALL
export __SYSTEM_AMBIENT_RELEASE_ARCHITECTURE
export __AMBIENT

if [ -n "$__PATH_PREFIX" ]; then
   case ":$PATH:" in
      *":$__PATH_PREFIX:"*) ;;
      *) PATH="$__PATH_PREFIX:$PATH" ;;
   esac
   export PATH
fi

if [ -z "$SSH_AUTH_SOCK" ] && [ -f "$HOME/.ssh/id_auth" ]; then
   if [ -r "$HOME/code/operating_system/tool/bin/defer_ssh_agent" ]; then
      . "$HOME/code/operating_system/tool/bin/defer_ssh_agent"
   fi
fi
